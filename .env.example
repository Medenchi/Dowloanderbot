# Обязательно
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# polling (по умолчанию) или webhook
MODE=polling
# WEBHOOK_URL=https://bot.example.com/tg
# WEBHOOK_SECRET=long-random-string
# WEBHOOK_PATH=/tg
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8080

# «Чтобы большие файлы не положили сервер»
MAX_PARALLEL=2            # одновременно качающих/пережимающих задач
MAX_QUEUE=40              # дальше — вежливый отказ, а не бесконечная очередь
MAX_UPLOAD_MB=48          # целевой потолок sendVideo (лимит Bot API = 50 МБ)
MAX_ORIGINAL_MB=400       # жёсткий max_filesize для yt-dlp (защита диска)
MAX_IMAGE_MB=9            # фото >10 МБ Telegram не принимает как photo
MAX_SLIDES=20             # слайдов в карусели (TikTok даёт до 35)
KEEP_FILES_MIN=30         # TTL временных файлов карусели
RATE_PER_30S=4            # ссылок от одного пользователя за 30 секунд
INSPECT_TIMEOUT=70
DOWNLOAD_TIMEOUT=600
ENCODE_TIMEOUT=600

# Доступ к приватным/возрастным постам (опционально, Netscape cookies.txt)
COOKIES_FILE=
# Прокси для yt-dlp, если площадка режет датацентры
HTTPS_PROXY=

# Карусели
USE_GALLERY_DL=1
# Bot API 10.5: принудительно default-режим callback'ов (иначе возможен inline_message_id)
ENSURE_CALLBACK_MODE_DEFAULT=0

DB_PATH=state.sqlite3
TMP_DIR=tmp
LOG_LEVEL=INFO
